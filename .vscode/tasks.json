{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test: All",
      "detail": "Runs every workspace member with tests",
      "group": "test",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/test-all.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Connector: Build",
      "detail": "Compiles the Remote Rift Connector API into an executable",
      "group": "build",
      "type": "shell",
      "command": "dart",
      "args": [
        "compile",
        "exe",
        "lib/src/cli/main.dart",
        "-o",
        "build/remoterift"
      ],
      "options": {
        "cwd": "${workspaceFolder}/packages/api"
      },
      "problemMatcher": []
    },
    {
      "label": "Website: Dev",
      "dependsOn": [
        "Website: Tailwind Watch",
        "Website: Jaspr Serve"
      ],
      "problemMatcher": []
    },
    {
      "label": "Website: Tailwind Watch",
      "type": "shell",
      "command": "tailwindcss",
      "args": [
        "--input",
        "styles.tw.css",
        "--output",
        "web/styles.css",
        "--watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/website"
      },
      "presentation": {
        "group": "dev"
      },
      "problemMatcher": []
    },
    {
      "label": "Website: Jaspr Serve",
      "type": "shell",
      "command": "jaspr",
      "args": [
        "serve"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/website"
      },
      "presentation": {
        "group": "dev"
      },
      "problemMatcher": []
    }
  ]
}
