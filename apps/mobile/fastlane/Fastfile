require "plist"
require "securerandom"

def required_env(name)
  value = ENV[name]
  UI.user_error!("Set #{name}.") if value.to_s.empty?
  value
end

platform :android do
  lane :deploy do
    upload_to_play_store(
      package_name: required_env("ANDROID_APPLICATION_ID"),
      json_key_data: required_env("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"),
      aab: File.expand_path("../build/app/outputs/bundle/release/app-release.aab"),
      mapping: File.join(ENV.fetch("RUNNER_TEMP"), "native-debug-symbols.zip"),
      track: "beta",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  lane :setup_signing do
    signing_dir = File.join(ENV.fetch("RUNNER_TEMP"), "ios-signing")
    team_id = required_env("IOS_TEAM_ID")
    keychain = File.join(signing_dir, "signing.keychain-db")
    keychain_password = SecureRandom.hex(32)

    create_keychain(path: keychain, password: keychain_password, unlock: true)
    import_certificate(
      keychain_path: keychain,
      keychain_password: keychain_password,
      certificate_path: File.join(signing_dir, "distribution.p12"),
      certificate_password: required_env("IOS_CERTIFICATE_PASSWORD")
    )
    profile = install_provisioning_profile(path: File.join(signing_dir, "distribution.mobileprovision"))
    profile_id = File.basename(profile, ".mobileprovision")
    update_code_signing_settings(
      path: File.expand_path("../ios/Runner.xcodeproj"),
      targets: ["Runner"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_id
    )

    export_options = Plist.parse_xml("../ios/ExportOptions.template.plist")
    export_options["teamID"] = team_id
    bundle_id = FastlaneCore::ProvisioningProfile.bundle_id(profile)
    export_options["provisioningProfiles"] = { bundle_id => profile_id }
    File.write(File.join(signing_dir, "ExportOptions.plist"), Plist::Emit.dump(export_options))
  end

  lane :deploy do
    ipas = Dir["../build/ios/ipa/*.ipa"]
    UI.user_error!("Expected exactly one IPA in build/ios/ipa.") unless ipas.one?

    api_key = app_store_connect_api_key(
      key_id: required_env("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: required_env("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: required_env("APP_STORE_CONNECT_PRIVATE_KEY")
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: File.expand_path(ipas.first),
      app_identifier: required_env("IOS_BUNDLE_ID"),
      skip_waiting_for_build_processing: true
    )
  end
end
